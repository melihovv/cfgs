# in order to use aliases with sudo
alias sudo="sudo "
alias c="clear"
alias q="exit"
alias й="exit"
alias l="less"
alias rmr="rm -rf"

alias G=" | grep"
alias L=" | less"

alias g="git"
alias gst="git status"
alias gp="git push"
alias gpu="git pull"
alias nah='git reset --hard && git clean -f'

if [ `echo $TERM` != "cygwin" ];
then
    alias tmux="TERM=xterm-256color tmux"
fi

alias doc="docker"
alias dc="docker-compose"

if [ "$(uname -s)" = "Linux" ]; then
    alias ls="ls --color=auto --group-directories-first"
    alias ll="ls -AlFh --color=auto --group-directories-first"

    alias copy="xclip -sel clip"
    alias paste="xclip -sel clip -o"

    alias open="xdg-open"
elif [ "$(uname -s)" = "Darwin" ]; then
    alias ll="ls -alFh"

    alias copy="pbcopy"
    alias paste="pbpaste"
fi

alias ..="cd .."
alias ...="cd ../.."

alias co="composer"
alias cdu="composer dump-autoload"
alias coi="composer install"
alias coui="composer update --ignore-platform-req=ext-elastic_apm"
alias cori="composer remove --ignore-platform-req=ext-elastic_apm"
alias cor="composer require"
alias corei="composer require --ignore-platform-req=ext-elastic_apm"
alias cord="composer require --dev"
alias cou="composer update"

composer-link() {
    composer config repositories path $1 --file composer.json
}

alias phpd="php -dzend_extension=/opt/homebrew/Cellar/php@8.2/8.2.29/pecl/20220829/xdebug.so -dxdebug.start_with_request=yes -dxdebug.mode=develop,debug,coverage"
#alias phpd="php -dzend_extension=/opt/homebrew/Cellar/php@8.1/8.1.32_1/pecl/20210902/xdebug.so -dxdebug.start_with_request=yes -dxdebug.mode=develop,debug,coverage"
#alias phpd="php -dzend_extension=/opt/homebrew/Cellar/php@8.3/8.3.16/pecl/20230831/xdebug.so -dxdebug.start_with_request=yes -dxdebug.mode=develop,debug,coverage"

alias ar="php artisan"
alias ars="php artisan serve"
alias art="php artisan tinker"
alias ar:mi="php artisan migrate"
alias ar:mis="php artisan migrate --seed"
alias ar:mir="php artisan migrate:refresh"
alias ar:mirs="php artisan migrate:refresh --seed"
alias ar:mire="php artisan migrate:reset && php artisan migrate --seed"
alias ar:ih:m="php artisan ide-helper:models -N"

alias an="ansible"
alias anp="ansible-playbook"
alias anv="ansible-vault"
alias ang="ansible-galaxy"

alias я="z"

mkcd() {
    mkdir -p "$1" && cd "$1"
}

path() {
    tr ':' '\n' <<< "$PATH"
}
